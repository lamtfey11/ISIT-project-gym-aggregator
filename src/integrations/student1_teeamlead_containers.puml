Rel(partner_web, api_gateway, "Запросы управления и аналитики", "HTTPS/JSON")

Rel(api_gateway, database, "Чтение / запись", "SQL/TCP")
Rel(api_gateway, payment_gateway, "Проведение оплаты", "HTTPS/REST")
Rel(api_gateway, maps_service, "Геокодирование адресов", "HTTPS/REST")

Rel(api_gateway, message_broker, "Публикует событие (оплата, бронь)", "AMQP")
Rel(message_broker, notification_service, "Доставляет событие подписчику", "AMQP")
Rel(message_broker, analytics_service, "Передаёт событие для агрегации", "AMQP")

Rel(api_gateway, monitoring, "Отправляет метрики и логи", "HTTP / Prometheus exporter")
Rel(database, monitoring, "Отправляет метрики состояния БД", "HTTP / Prometheus exporter")
Rel(message_broker, monitoring, "Отправляет метрики очереди", "HTTP / Prometheus exporter")

