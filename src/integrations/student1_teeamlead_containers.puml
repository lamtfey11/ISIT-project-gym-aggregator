Person(client, "Клиент", "Ищет фитнес-залы рядом и покупает абонементы онлайн")
Person(partner_admin, "Администратор зала (партнёр)", "Публикует зал в каталоге, управляет тарифами, расписанием и наполнением карточки")
Person(platform_operator, "Оператор платформы", "Проверяет и одобряет карточки залов перед публикацией, настраивает условия комиссии")

System_Ext(payment_gateway, "Банковский эквайринг / платёжный шлюз", "Внешняя платёжная система")
System_Ext(maps_service, "Картографический сервис", "Внешний провайдер карт и геокодирования")
System_Ext(sms_provider, "Провайдер SMS / Push-уведомлений", "Внешний сервис доставки уведомлений")

System_Boundary(fitness_platform, "Fitness Aggregator") {

    'Зона: Frontend/Mobile'
    Container(mobile_app, "Мобильное приложение клиента", "React Native", "Поиск залов рядом, каталог, оплата абонемента")
    Container(partner_web, "Веб-кабинет партнёра и оператора", "React / TypeScript (SPA)", "Управление карточкой зала, тарифами, модерация (role-based доступ)")

    'Зона: Backend'
    Container(api_gateway, "Backend API Gateway", "Python / FastAPI", "Маршрутизация запросов, бизнес-логика, идемпотентная обработка оплат")
    ContainerDb(database, "Реляционная СУБД", "PostgreSQL + PostGIS", "Хранит данные пользователей, залов, тарифов, геоиндексы для поиска")

    'Зона: DevOps (инфраструктурные контейнеры)'
    ContainerQueue(message_broker, "Брокер сообщений", "RabbitMQ", "Асинхронная передача событий (оплата, бронирование) между сервисами")
    Container(monitoring, "Система мониторинга", "Grafana + Prometheus", "Отслеживает состояние сервисов, метрики производительности и аптайм")
    Container(notification_service, "Сервис уведомлений", "Python (worker)", "Подписывается на события и рассылает уведомления")

    'Зона: Analytics'
    Container(analytics_service, "Сервис аналитики и отчётности", "Python", "Строит отчёты и дашборды продаж для партнёров")
}

