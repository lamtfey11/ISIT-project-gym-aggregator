@startuml main_context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title Сводная диаграмма системного контекста ИС "Агрегатор фитнес-клубов"

' === ГЛОБАЛЬНЫЕ АКТОРЫ (единый пул, зона ответственности Тимлида) ===
Person(client, "Клиент", "Посетитель фитнес-зала: ищет зал рядом, покупает абонемент, проходит в зал по QR-пропуску")
Person(gym_admin, "Администратор зала", "Сотрудник партнёрского зала: ведёт карточку, тарифы и расписание, смотрит отчёты")
Person(platform_operator, "Оператор платформы", "Сотрудник платформы: модерирует залы, настраивает тарифы и комиссии, обрабатывает обращения")
Person(analyst, "Аналитик платформы", "Проектирует показатели и витрины, готовит регламентную и ad-hoc отчётность")
Person(devops, "DevOps-инженер", "Выпускает релизы, следит за доступностью и метриками, реагирует на сбои")

' === ПРОЕКТИРУЕМАЯ СИСТЕМА (чёрный ящик) ===
System(gym_aggregator, "ИС-агрегатор фитнес-клубов", "Единая платформа: геопоиск малых фитнес-залов, каталог и расписание, онлайн-продажа абонементов, допуск в зал по QR-пропуску, индекс загруженности, аналитика для залов и платформы")

' === ГЛОБАЛЬНЫЕ ВНЕШНИЕ СИСТЕМЫ (единый перечень, вне контроля команды) ===
System_Ext(payment_gateway, "Платёжный шлюз", "Эквайринг с поддержкой маркетплейс-схемы: платежи, возвраты, выплаты залам")
System_Ext(maps_service, "Картографический сервис", "Яндекс Карты / 2ГИС: карта, геокодирование, маршруты")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "FCM / APNs, SMS-шлюз, SMTP-сервер")
System_Ext(access_control, "СКУД и датчики залов", "Турникеты и считыватели на стороне партнёра: фиксируют вход и выход, проверяют пропуск")
System_Ext(idp, "Провайдер идентификации", "VK ID / Sber ID: внешняя аутентификация по OAuth 2.0 / OIDC")
System_Ext(bi_platform, "BI-платформа", "Yandex DataLens: интерактивные дашборды поверх витрин данных")
System_Ext(accounting_system, "Система бухгалтерского учёта", "1С:Бухгалтерия: акты и реестры начислений по залам")

' === СВЯЗИ: АКТОРЫ (стрелка = инициатор сессии) ===
Rel(client, gym_aggregator, "Ищет залы рядом, оформляет и оплачивает абонемент, проходит в зал по QR-пропуску", "HTTPS/JSON")
Rel(gym_admin, gym_aggregator, "Ведёт карточку, тарифы и расписание зала, смотрит посещения и отчёты", "HTTPS/JSON")
Rel(platform_operator, gym_aggregator, "Подключает и модерирует залы, настраивает тарифы и комиссии, обрабатывает обращения и возвраты", "HTTPS/JSON")
Rel(analyst, gym_aggregator, "Настраивает показатели и витрины, формирует регламентные отчёты", "HTTPS/JSON")
Rel(devops, gym_aggregator, "Смотрит метрики, логи и состояние сервисов", "HTTPS")
Rel(analyst, bi_platform, "Строит ad-hoc дашборды и проверяет гипотезы поверх витрин", "HTTPS")

' === СВЯЗИ: ВНЕШНИЕ СИСТЕМЫ ===
Rel(gym_aggregator, payment_gateway, "Создаёт платежи, оформляет возвраты и выплаты залам", "HTTPS/REST")
Rel(payment_gateway, gym_aggregator, "Сообщает статус платежа (webhook)", "HTTPS/JSON")
Rel(gym_aggregator, maps_service, "Запрашивает карту, геокодирование адресов и время в пути", "HTTPS/REST")
Rel(gym_aggregator, notification_gateway, "Передаёт push, SMS и e-mail на доставку, отправляет оповещения об инцидентах", "HTTPS/REST, SMTP/TLS")
Rel(access_control, gym_aggregator, "Передаёт запросы валидации пропуска и события прохода, получает команды допуска", "MQTTS / TLS")
Rel(gym_aggregator, idp, "Передаёт запрос авторизации, получает подтверждённый профиль", "HTTPS, OAuth 2.0 / OIDC")
Rel(bi_platform, gym_aggregator, "Читает витрины данных для дашбордов", "SQL over HTTPS")
Rel(gym_aggregator, accounting_system, "Выгружает реестры начислений и акты по залам за период", "HTTPS/REST, XML")

' === СВЯЗИ: ДОСТАВКА УВЕДОМЛЕНИЙ ЛЮДЯМ ===
Rel(notification_gateway, client, "Доставляет push- и SMS-уведомления на устройство", "FCM/APNs, SMS")
Rel(notification_gateway, gym_admin, "Доставляет отчёт по загрузке и продажам зала", "E-mail (SMTP)")
Rel(notification_gateway, analyst, "Доставляет оповещения о сбое расчёта витрин", "E-mail (SMTP)")
Rel(notification_gateway, devops, "Доставляет оповещения об инцидентах", "E-mail (SMTP)")

@enduml