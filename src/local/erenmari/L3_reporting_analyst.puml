@startuml "Fitness Aggregator - Reporting Service Components (Analyst)"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов C4 (Level 3) — контейнер «Сервис отчётности»

' ==== ВНЕШНИЕ ПО ОТНОШЕНИЮ К КОНТЕЙНЕРУ ЭЛЕМЕНТЫ ====
Container_Ext(api_gateway, "API-шлюз", "Nginx", "Единая точка входа: терминация TLS 1.3, маршрутизация, проверка токена через сервис авторизации, ограничение частоты запросов, приём webhook и запросов BI.")
Container_Ext(monitoring, "Система наблюдаемости", "Prometheus, Alertmanager, Grafana, Loki", "Собирает метрики и логи контейнеров, строит панели, рассылает оповещения об инцидентах напрямую по SMTP, чтобы оповещение о сбое не зависело от наблюдаемых сервисов.")
Container_Boundary(analytics_service, "Сервис отчётности [Python 3.12 / FastAPI, pandas]") {

  ' ---- Слой представления (API) ----
  Component(report_controller, "Контроллер отчётности", "FastAPI Router", "Принимает запросы показателей, формирования отчётов, реестров и выгрузок, проверяет права роли и параметры периода; отдаёт метрики сервиса (/metrics).")

  ' ---- Слой бизнес-логики ----
  Component(metrics_engine, "Модуль расчёта показателей", "Python, pandas", "Считает загрузку залов, воронку покупок, выручку и комиссии по витринам за заданный период и разрез; суммы денег берёт из витрин как есть, не пересчитывая.")
  Component(report_builder, "Сборщик отчётов", "Python, openpyxl, csv", "Собирает регламентные отчёты и выгрузки XLSX и CSV по шаблонам, формирует листы и итоговые строки, выдаёт ссылку на готовый файл.")
  Component(settlement_exporter, "Модуль реестров начислений", "Python, lxml", "Формирует реестры начислений и акты по залам за период в формате обмена с бухгалтерией из реестра выплат, суммы не пересчитывает.")

  ' ---- Слой доступа к данным и инфраструктуре ----
  Component(mart_repository, "Репозиторий витрин", "Python, clickhouse-connect", "Абстрагирует аналитическое хранилище: строит и выполняет запросы к витринам, возвращает наборы данных.")
  Component(storage_gateway, "Шлюз файлового хранилища", "Python, boto3 (S3 API)", "Сохраняет готовые файлы отчётов, ведёт версии и выдаёт ссылки на скачивание.")
  Component(event_publisher, "Издатель событий", "Python, pika (AMQP)", "Публикует событие report.ready для последующей рассылки уведомлений.")
}

' ==== ВНЕШНИЕ ПО ОТНОШЕНИЮ К КОНТЕЙНЕРУ ХРАНИЛИЩА И СИСТЕМЫ ====
ContainerDb_Ext(dwh, "Аналитическое хранилище и витрины", "ClickHouse", "Денормализованные витрины: загрузка залов, воронка покупок, выручка и комиссии, выплаты залам.")
ContainerDb_Ext(object_storage, "Объектное хранилище", "MinIO (S3 API)", "Фотографии залов, аватары, документы партнёров, файлы готовых отчётов.")
ContainerQueue_Ext(message_broker, "Брокер сообщений", "RabbitMQ 3", "Доменные события между сервисами (заказы, абонементы, платежи, проходы, готовность отчётов): topic-обменник, у каждого подписчика своя очередь, единый JSON-конверт с идентификатором события.")
System_Ext(accounting_system, "Система бухгалтерского учёта", "1С:Бухгалтерия: акты и реестры начислений")
' ==== ВХОД В КОНТЕЙНЕР ====
Rel(api_gateway, report_controller, "Проксирует запросы отчётности", "HTTP/JSON, TCP 8003")
Rel(monitoring, report_controller, "Опрашивает метрики сервиса", "HTTP GET /metrics")

' ==== ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ  ====
Rel(report_controller, metrics_engine, "Запрашивает расчёт показателей за период", "Python Call")
Rel(report_controller, report_builder, "Запрашивает сборку файла отчёта и ссылку на готовый файл", "Python Call")
Rel(report_controller, settlement_exporter, "Запрашивает реестр начислений по залам", "Python Call")
Rel(metrics_engine, mart_repository, "Запрашивает наборы данных из витрин", "Python Call")
Rel(report_builder, metrics_engine, "Получает рассчитанные показатели для листов отчёта", "Python Call")
Rel(settlement_exporter, mart_repository, "Запрашивает реестр выплат залам за период", "Python Call")
Rel(report_builder, storage_gateway, "Передаёт готовый файл на сохранение, запрашивает ссылку на скачивание", "Python Call")
Rel(report_builder, event_publisher, "Сообщает о готовности отчёта", "Python Call")

' ==== СЕТЕВЫЕ СВЯЗИ КОМПОНЕНТОВ С ХРАНИЛИЩАМИ И ВНЕШНИМИ СИСТЕМАМИ ====
Rel(mart_repository, dwh, "Выполняет аналитические запросы к витринам", "HTTP, TCP 8123")
Rel(storage_gateway, object_storage, "Сохраняет и отдаёт файлы отчётов", "HTTPS (S3 API), TCP 9000")
Rel(event_publisher, message_broker, "Публикует report.ready", "AMQP, TCP 5672")
Rel(settlement_exporter, accounting_system, "Передаёт реестры начислений и акты по залам", "HTTPS/REST, XML")

@enduml
