@startuml "Fitness Aggregator - System Context (Analyst)"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Диаграмма системного контекста ИС-агрегатора фитнес-клубов (фокус: аналитика и отчётность)

' ==== ПОЛЬЗОВАТЕЛИ (верхний ряд диаграммы) ====
Person(visitor, "Посетитель", "Ищет клубы, записывается и оплачивает посещения; его действия формируют поведенческие данные")
Person(club_admin, "Администратор клуба", "Ведёт расписание и посещения, запрашивает отчёты по загрузке зала и выплатам")
Person(operator, "Оператор платформы", "Модерирует клубы и комиссии, работает со сводными показателями платформы")
Person(analyst, "Аналитик платформы", "Проектирует показатели и витрины, готовит регламентную и ad-hoc отчётность")

' ==== ВНЕШНИЕ СИСТЕМЫ: ЛЕВЫЙ ПЕРИМЕТР (источники данных) ====
System_Ext(payment_gateway, "Платёжная система", "Источник реестров платежей и выплат клубам для финансовой сверки")
System_Ext(web_analytics, "Сервис веб- и мобильной аналитики", "Яндекс Метрика / AppMetrica: источники трафика, воронки, конверсии")

' ==== ПРОЕКТИРУЕМАЯ СИСТЕМА (центр диаграммы) ====
System(fitness_system, "ИС-агрегатор фитнес-клубов", "Поиск клубов, запись и оплата посещений, расчёты с клубами, сбор и анализ данных о работе платформы")

' ==== ВНЕШНИЕ СИСТЕМЫ: ПРАВЫЙ ПЕРИМЕТР (потребители данных) ====
System_Ext(bi_platform, "BI-платформа", "Yandex DataLens: интерактивные дашборды поверх витрин данных")
System_Ext(accounting_system, "Система бухгалтерского учёта", "1С:Бухгалтерия: акты и реестры начислений по клубам")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "SMTP-сервер, SMS-шлюз, Push: доставка отчётов и оповещений")

' ==== СВЯЗИ «ПОЛЬЗОВАТЕЛЬ -> СИСТЕМА» (задают верхний ряд) ====
Rel(visitor, fitness_system, "Ищет клубы, записывается и оплачивает посещения (источник событий о спросе)", "HTTPS/JSON")
Rel(club_admin, fitness_system, "Запрашивает отчёты по загрузке зала, посещаемости и начислениям", "HTTPS/JSON")
Rel(operator, fitness_system, "Смотрит сводные показатели платформы, выгружает реестры по клубам", "HTTPS/JSON")
Rel(analyst, fitness_system, "Настраивает показатели и витрины, формирует регламентные отчёты", "HTTPS/JSON")

' ==== СВЯЗИ «ПОЛЬЗОВАТЕЛЬ -> ВНЕШНЯЯ СИСТЕМА» (удерживают внешние системы на уровне центра) ====
Rel(analyst, bi_platform, "Строит ad-hoc дашборды и проверяет гипотезы поверх витрин", "HTTPS")
Rel(notification_gateway, club_admin, "Доставляет отчёт о загрузке клуба за период", "E-mail")
Rel(notification_gateway, analyst, "Доставляет оповещения о сбое расчёта витрин", "E-mail")

' ==== СВЯЗИ «СИСТЕМА <-> ВНЕШНИЕ СИСТЕМЫ» (левый периметр) ====
Rel(fitness_system, payment_gateway, "Запрашивает реестры проведённых платежей и выплат для сверки", "HTTPS/REST")
Rel(payment_gateway, fitness_system, "Передаёт статусы платежей и суммы выплат клубам", "HTTPS/JSON, вебхук")
Rel(fitness_system, web_analytics, "Передаёт события пользовательских сессий и экранов", "HTTPS/JSON")
Rel(web_analytics, fitness_system, "Отдаёт агрегаты по источникам трафика и конверсии записей", "HTTPS/REST API")

' ==== СВЯЗИ «СИСТЕМА -> ВНЕШНИЕ СИСТЕМЫ» (правый периметр) ====
Rel(fitness_system, bi_platform, "Публикует витрины данных для построения дашбордов", "SQL over TLS")
Rel(fitness_system, accounting_system, "Выгружает реестры начислений и акты по клубам за период", "HTTPS/REST, XML")
Rel(fitness_system, notification_gateway, "Отправляет регламентные отчёты и оповещения об отклонении показателей", "SMTP/TLS, HTTPS/REST")

' ==== ОПЦИОНАЛЬНО: жёсткая фиксация периметра (раскомментировать, если нам разрешат Lay_* :ззз ) ====
' Lay_L(fitness_system, payment_gateway)
' Lay_L(fitness_system, web_analytics)
' Lay_R(fitness_system, bi_platform)
' Lay_R(fitness_system, accounting_system)
' Lay_R(fitness_system, notification_gateway)

@enduml
