@startuml "Fitness Aggregator - ETL Service Components (Analyst)"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов C4 (Level 3) — контейнер «Сервис загрузки данных (ETL)»

' ==== ДЕКОМПОЗИРУЕМЫЙ КОНТЕЙНЕР ====
Container_Boundary(etl_service, "Сервис загрузки данных (ETL) [Python 3.12 / Apache Airflow, pandas]") {

  ' ---- Слой оркестрации ----
  Component(dag_scheduler, "Планировщик загрузок", "Apache Airflow (DAG, Scheduler)", "Запускает регламентные загрузки по расписанию, задаёт порядок шагов, повторяет шаг при сбое и фиксирует итог запуска.")

  ' ---- Слой извлечения данных ----
  Component(db_extractor, "Экстрактор справочников и реестра выплат", "Python, SQLAlchemy", "Инкрементально выгружает из СУБД справочники (залы, тарифы абонементов, условия размещения) и реестр выплат по метке последней успешной загрузки; факты из СУБД не берёт.")
  Component(event_consumer, "Потребитель потока событий", "Python, pika (AMQP)", "Вычитывает из собственной очереди пачки доменных событий (order.created, subscription.*, payment.*, access.passed, report.ready) и подтверждает их обработку.")

  ' ---- Слой преобразования и контроля качества ----
  Component(transform_engine, "Модуль преобразования", "Python, pandas", "Приводит типы, устраняет дубли событий по идентификатору события, соединяет факты со справочниками и рассчитывает агрегаты будущих витрин.")
  Component(dq_validator, "Модуль контроля качества данных", "Python, pandas", "Проверяет полноту, типы и бизнес-правила партии по профилю витрины; отбраковывает партию целиком при нарушении контрольных правил, строки с предупреждениями отправляет в карантин.")

  ' ---- Слой загрузки ----
  Component(mart_loader, "Загрузчик витрин", "Python, clickhouse-connect", "Атомарно записывает проверенную партию в витрины и обновляет журнал загрузок и метки инкремента.")
}

' ==== ВНЕШНИЕ ПО ОТНОШЕНИЮ К КОНТЕЙНЕРУ ХРАНИЛИЩА (нижний ярус, описания совпадают со сводной диаграммой контейнеров) ====
ContainerDb_Ext(database, "Реляционная СУБД", "PostgreSQL 16 + PostGIS 3", "Основное хранилище: пользователи и роли, залы и геоиндексы, тарифы абонементов, условия размещения и комиссии, абонементы, заказы, платежи, реестр выплат, посещения, журнал операций. У каждой таблицы один сервис-владелец, который в неё пишет.")
ContainerQueue_Ext(message_broker, "Брокер сообщений", "RabbitMQ 3", "Доменные события между сервисами (заказы, абонементы, платежи, проходы, готовность отчётов): topic-обменник, у каждого подписчика своя очередь, единый JSON-конверт с идентификатором события.")
ContainerDb_Ext(dwh, "Аналитическое хранилище и витрины", "ClickHouse", "Денормализованные витрины: загрузка залов, воронка покупок, выручка и комиссии, выплаты залам.")
' ==== ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ (единое адресное пространство) ====
Rel(dag_scheduler, db_extractor, "Запускает шаг выгрузки за интервал", "Python Call")
Rel(dag_scheduler, event_consumer, "Запускает вычитывание пачки событий", "Python Call")
Rel(db_extractor, transform_engine, "Передаёт справочники и реестр выплат", "Python Call")
Rel(event_consumer, transform_engine, "Передаёт пачку событий", "Python Call")
Rel(transform_engine, dq_validator, "Отдаёт подготовленную партию на проверку", "Python Call")
Rel(dq_validator, mart_loader, "Передаёт партию, прошедшую контроль качества", "Python Call")
Rel(mart_loader, dag_scheduler, "Возвращает итог загрузки: число строк и отбраковок", "Python Call")

' ==== СЕТЕВЫЕ СВЯЗИ КОМПОНЕНТОВ С ХРАНИЛИЩАМИ ====
Rel(db_extractor, database, "Инкрементально выгружает справочники и реестр выплат", "SQL/TCP, TCP 5432")
Rel(event_consumer, message_broker, "Получает доменные события из собственной очереди", "AMQP, TCP 5672")
Rel(mart_loader, dwh, "Загружает очищенные данные и пересчитывает витрины", "HTTP, TCP 8123")
Rel(dag_scheduler, dwh, "Читает метки инкремента, пишет статус запуска в журнал загрузок", "HTTP, TCP 8123")

@enduml
