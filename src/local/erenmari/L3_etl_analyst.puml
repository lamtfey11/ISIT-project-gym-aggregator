@startuml "Fitness Aggregator - ETL Service Components (Analyst)"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов C4 (Level 3) — контейнер «Сервис загрузки данных (ETL)»

' ==== ДЕКОМПОЗИРУЕМЫЙ КОНТЕЙНЕР ====
Container_Boundary(etl_service, "Сервис загрузки данных (ETL) [Python 3.12 / Apache Airflow, pandas]") {

  ' ---- Слой оркестрации ----
  Component(dag_scheduler, "Планировщик загрузок", "Apache Airflow (DAG, Scheduler)", "Запускает регламентные загрузки по расписанию, задаёт порядок шагов, повторяет шаг при сбое и фиксирует итог запуска.")

  ' ---- Слой извлечения данных ----
  Component(db_extractor, "Экстрактор операционных данных", "Python, SQLAlchemy", "Инкрементально выгружает заказы, абонементы, платежи и посещения из СУБД по метке последней успешной загрузки.")
  Component(event_consumer, "Потребитель потока событий", "Python, pika (AMQP)", "Вычитывает пачки событий оплат, подписок и проходов из очередей брокера, подтверждает обработку сообщений.")

  ' ---- Слой преобразования и контроля качества ----
  Component(transform_engine, "Модуль преобразования", "Python, pandas", "Приводит типы, дедуплицирует записи, соединяет источники и рассчитывает агрегаты будущих витрин.")
  Component(dq_validator, "Модуль контроля качества данных", "Python, Great Expectations", "Проверяет полноту, типы и бизнес-правила партии; отбраковывает партию целиком при нарушении контрольных правил.")

  ' ---- Слой загрузки ----
  Component(mart_loader, "Загрузчик витрин", "Python, clickhouse-connect", "Атомарно записывает проверенную партию в витрины и обновляет журнал загрузок и метки инкремента.")
}

' ==== ВНЕШНИЕ ПО ОТНОШЕНИЮ К КОНТЕЙНЕРУ ХРАНИЛИЩА (нижний ярус) ====
ContainerDb(database, "Реляционная СУБД", "PostgreSQL 16 + PostGIS 3", "Операционные данные: заказы, абонементы, платежи, посещения")
ContainerQueue(message_broker, "Брокер сообщений", "RabbitMQ 3", "События заказов, подписок, оплат и проходов")
ContainerDb(dwh, "Аналитическое хранилище и витрины", "ClickHouse", "Витрины загрузки залов, воронки и выручки, журнал загрузок")

' ==== ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ (единое адресное пространство) ====
Rel(dag_scheduler, db_extractor, "Запускает шаг выгрузки за интервал", "Python Call")
Rel(dag_scheduler, event_consumer, "Запускает вычитывание пачки событий", "Python Call")
Rel(db_extractor, transform_engine, "Передаёт сырые наборы данных", "Python Call")
Rel(event_consumer, transform_engine, "Передаёт пачку нормализованных событий", "Python Call")
Rel(transform_engine, dq_validator, "Отдаёт подготовленную партию на проверку", "Python Call")
Rel(dq_validator, mart_loader, "Передаёт партию, прошедшую контроль качества", "Python Call")
Rel(mart_loader, dag_scheduler, "Возвращает итог загрузки: число строк и отбраковок", "Python Call")

' ==== СЕТЕВЫЕ СВЯЗИ КОМПОНЕНТОВ С ХРАНИЛИЩАМИ ====
Rel(db_extractor, database, "Инкрементально выгружает операционные данные", "SQL/TCP, TCP 5432")
Rel(event_consumer, message_broker, "Читает поток событий для загрузки в витрины", "AMQP, TCP 5672")
Rel(mart_loader, dwh, "Загружает очищенные партии и пересчитывает витрины", "HTTP, TCP 8123")
Rel(dag_scheduler, dwh, "Читает метки инкремента, пишет статус запуска в журнал загрузок", "HTTP, TCP 8123")

' ==== ОПЦИОНАЛЬНО: фиксация раскладки (раскомментировать, если преподаватель разрешит Lay_*) ====
' Lay_L(mart_loader, database)
' Lay_R(mart_loader, dwh)

@enduml
