@startuml L2

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title Диаграмма контейнеров (Level 2) — ИС "Агрегатор спортивных залов"

' Актёры
Person(client, "Клиент", "Посетитель спортивных залов")
Person(gym_admin, "Администратор зала", "Сотрудник подключённого зала")
Person(platform_admin, "Администратор платформы", "Сотрудник оператора сервиса")

' Границы системы
System_Boundary(gym_aggregator, "Агрегатор спортивных залов") {
    Container(mobile_app, "Мобильное приложение клиента", "React Native", "Отображает карту залов с индексом загруженности, избранные залы, оформление и оплату абонемента.")
    Container(admin_web, "Веб-панель администрирования", "React / TypeScript (SPA)", "Рабочее место администратора зала и администратора платформы: карточка зала, ручная отметка посещений, отчёты, модерация и тарифы.")
    Container(api_gateway, "API-бэкенд", "Python 3.12 / FastAPI", "Ядро системы. Реализует бизнес-логику: авторизация и разграничение прав, каталог залов, абонементы, аналитика посещаемости, интеграция с внешними сервисами.")
    Container(occupancy_service, "Сервис приёма событий загруженности", "Python 3.12 / asyncio", "Асинхронно принимает события прохода от разнородных источников, приводит их к единому формату и рассчитывает индекс загруженности зала по 10-балльной шкале.")
    ContainerDb(database, "База данных", "PostgreSQL 16", "Хранит справочник залов, профили пользователей, историю посещений, абонементы и журнал операций.")
    ContainerDb(cache, "Кэш и хранилище сессий", "Redis 7", "Хранит актуальные значения индекса загруженности для быстрой отдачи на карту, сессии и токены авторизации.")
}

' Внешние системы
System_Ext(maps_service, "Картографический сервис", "Яндекс.Карты: подложка карты и геокодирование")
System_Ext(payment_gateway, "Платёжный шлюз", "Внешний эквайринг: проведение платежей")
System_Ext(access_control, "СКУД и датчики залов", "Турникеты, считыватели карт, датчики прохода")
System_Ext(push_service, "Сервис push-уведомлений", "FCM / APNs: доставка уведомлений")

' Связи
Rel(client, mobile_app, "Подбирает зал, ведёт избранное, оформляет абонемент", "HTTPS / TLS 1.3")
Rel(gym_admin, admin_web, "Ведёт карточку зала, отмечает посещения, смотрит отчёты", "HTTPS / TLS 1.3")
Rel(platform_admin, admin_web, "Подключает и модерирует залы, настраивает тарифы", "HTTPS / TLS 1.3")

Rel(mobile_app, api_gateway, "Запрашивает каталог залов, индекс загруженности, оформление абонемента", "HTTPS / JSON, REST")
Rel(admin_web, api_gateway, "Передаёт изменения карточки зала и ручные отметки посещений, запрашивает аналитику", "HTTPS / JSON, REST")

Rel(api_gateway, occupancy_service, "Передаёт ручные отметки посещений и запрашивает пересчёт индекса", "HTTP / JSON, внутренняя сеть")
Rel(api_gateway, database, "Чтение и запись данных каталога, абонементов и истории посещений", "SQL / TCP, порт 5432")
Rel(api_gateway, cache, "Читает актуальный индекс загруженности, хранит сессии и токены", "RESP / TCP, порт 6379")
Rel(occupancy_service, database, "Сохраняет нормализованные события прохода и историю загруженности", "SQL / TCP, порт 5432")
Rel(occupancy_service, cache, "Публикует рассчитанный индекс загруженности залов", "RESP / TCP, порт 6379")

Rel(access_control, occupancy_service, "Публикует события прохода посетителей в топики залов", "MQTT / TCP, порт 8883")
Rel(mobile_app, maps_service, "Загружает картографическую подложку", "HTTPS / REST")
Rel(api_gateway, maps_service, "Геокодирует адреса подключаемых залов", "HTTPS / REST")
Rel(api_gateway, payment_gateway, "Инициирует списание за абонемент, запрашивает статус транзакции", "HTTPS / REST")
Rel(api_gateway, push_service, "Отправляет уведомления клиентам", "HTTPS / REST")

@enduml
