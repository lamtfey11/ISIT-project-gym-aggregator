@startuml L3_backend_auth
' Подключаем стандартный макрос для диаграммы компонентов
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов C4 (Level 3) — Сервис авторизации (auth_service)

' === СОСЕДНИЕ КОНТЕЙНЕРЫ И ВНЕШНИЕ СИСТЕМЫ  ===
System_Ext(idp, "Провайдер идентификации", "VK ID / Sber ID: OAuth 2.0 / OIDC")
Container_Ext(api_gateway, "API-шлюз", "Nginx", "Единая точка входа: терминация TLS 1.3, маршрутизация, проверка токена через сервис авторизации, ограничение частоты запросов, приём webhook и запросов BI.")
Container_Ext(monitoring, "Система наблюдаемости", "Prometheus, Alertmanager, Grafana, Loki", "Собирает метрики и логи контейнеров, строит панели, рассылает оповещения об инцидентах напрямую по SMTP, чтобы оповещение о сбое не зависело от наблюдаемых сервисов.")
ContainerDb_Ext(database, "Реляционная СУБД", "PostgreSQL 16 + PostGIS 3", "Основное хранилище: пользователи и роли, залы и геоиндексы, тарифы абонементов, условия размещения и комиссии, абонементы, заказы, платежи, реестр выплат, посещения, журнал операций. У каждой таблицы один сервис-владелец, который в неё пишет.")
ContainerDb_Ext(cache, "Кэш и хранилище сессий", "Redis 7", "Кэш геопоиска, актуальный индекс загруженности, сессии и токены, короткоживущие токены пропусков.")
' === ГРАНИЦА НАШЕГО КОНТЕЙНЕРА ===
Container_Boundary(auth_service, "Сервис авторизации (auth_service)") {

    ' --- СЛОЙ 1: Уровень API  ---
    Boundary(layer_api, "Слой 1: API (Delivery Layer)") {
        Component(auth_api, "API Аутентификации", "Python 3.12 / FastAPI", "Вход, регистрация, обновление токенов (refresh), проверка токена по подзапросу шлюза (/auth/verify, возвращает X-User-Id и X-User-Role); отдаёт метрики сервиса (/metrics)")
        Component(oauth_api, "API внешнего входа (SSO)", "Python 3.12 / FastAPI", "Обработка callback-запросов от VK/Sber")
        Component(user_api, "API Профилей", "Python 3.12 / FastAPI", "Управление профилями и ролями пользователей")
    }

    ' --- СЛОЙ 2: Уровень бизнес-логики  ---
    Boundary(layer_service, "Слой 2: Бизнес-логика (Service Layer)") {
        Component(auth_service_logic, "Сервис аутентификации", "Python 3.12", "Проверка паролей, генерация и валидация JWT")
        Component(oauth_service, "Сервис OAuth 2.0", "Python 3.12", "Логика обмена кодов на токены и маппинг пользователей")
        Component(user_service, "Сервис пользователей", "Python 3.12", "Проверка прав (RBAC), управление данными профиля")
        Component(session_service, "Сервис сессий", "Python 3.12", "Контроль жизненного цикла сессий (создание, отзыв), проверка, не отозван ли токен")
    }

    ' --- СЛОЙ 3: Уровень доступа к хранилищам  ---
    Boundary(layer_infra, "Слой 3: Инфраструктура (Data Access / Adapters)") {
        Component(db_repository, "Репозиторий пользователей", "Python 3.12 / SQLAlchemy 2.0", "Абстракция доступа к таблицам профилей в PostgreSQL")
        Component(cache_repository, "Репозиторий сессий", "Python 3.12 / Redis-py", "Абстракция доступа к in-memory хранилищу сессий")
        Component(idp_adapter, "Адаптер провайдера (IdP)", "Python 3.12", "Формирует HTTP-запросы к внешним серверам VK ID / Sber ID")
    }
}

' === СВЯЗИ: Входные ===
Rel(api_gateway, auth_api, "Проверка токена (подзапрос), логин, регистрация, рефреш токенов", "HTTP/JSON, TCP 8001")
Rel(api_gateway, oauth_api, "Перенаправление после входа в IdP", "HTTP/JSON, TCP 8001")
Rel(api_gateway, user_api, "Управление профилем", "HTTP/JSON, TCP 8001")
Rel(monitoring, auth_api, "Опрашивает метрики сервиса", "HTTP GET /metrics")

' === СВЯЗИ: API - Бизнес-логика ===
Rel(auth_api, auth_service_logic, "Инициирует авторизацию и проверку токена", "Python Call")
Rel(oauth_api, oauth_service, "Передает Authorization Code", "Python Call")
Rel(user_api, user_service, "Запрашивает данные профиля", "Python Call")

' === СВЯЗИ: Внутри бизнес-логики  ===
Rel(oauth_service, auth_service_logic, "Запрашивает выпуск локального JWT", "Python Call")
Rel(auth_service_logic, user_service, "Проверяет существование профиля и роли", "Python Call")
Rel(auth_service_logic, session_service, "Создает сессию, проверяет отзыв токена", "Python Call")

' === СВЯЗИ: Бизнес-логика - доступ к БД ===
Rel(user_service, db_repository, "Читает/пишет профили", "Python Call")
Rel(session_service, cache_repository, "Пишет/читает токены", "Python Call")
Rel(oauth_service, idp_adapter, "Инициирует запрос к провайдеру", "Python Call")

' === СВЯЗИ: Выходные ===
Rel(db_repository, database, "Читает и записывает профили пользователей и роли", "SQL/TCP, TCP 5432")
Rel(cache_repository, cache, "Хранит активные сессии и выпущенные токены", "RESP/TCP, TCP 6379")
Rel(idp_adapter, idp, "Обменивает код авторизации на подтверждённый профиль", "HTTPS, OAuth 2.0 / OIDC")

@enduml
