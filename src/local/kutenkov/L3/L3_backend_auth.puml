@startuml L3_backend_auth
' Подключаем стандартный макрос для диаграммы компонентов
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов (Level 3) — Сервис авторизации (auth_service)

' === ВНЕШНИЕ СИСТЕМЫ ===

System_Ext(idp, "Провайдер идентификации", "VK ID / Sber ID: внешняя аутентификация по OAuth 2.0 / OIDC")

' === КОНТЕЙНЕРЫ ===

Container(api_gateway, "API-шлюз", "Nginx", "Терминация TLS, проксирование")

ContainerDb(database, "Реляционная СУБД", "PostgreSQL 16", "Хранит профили и роли")

ContainerDb(cache, "Кэш и сессии", "Redis 7", "Хранит активные сессии и токены")

' === ГРАНИЦА КОНТЕЙНЕРА ===

Container_Boundary(auth_service, "Сервис авторизации (auth_service)") {

    Component(auth_comp, "Модуль авторизации", "Python / FastAPI", "Обеспечивает регистрацию, аутентификацию, выпуск и проверку JWT")

    Component(oauth_comp, "Модуль OAuth 2.0", "Python / Authlib", "Интеграция с внешними IdP провайдерами")

    Component(user_comp, "Модуль профилей и ролей", "Python / SQLAlchemy", "Управление профилями пользователей и RBAC")

    Component(session_comp, "Модуль управления сессиями", "Python / Redis", "Управление жизненным циклом сессий и токенов")

}

' === СВЯЗИ ===

' Извне в контейнер

Rel(api_gateway, auth_comp, "Запросы аутентификации и проверки токенов", "HTTP/JSON")

' Внутрипроцессные вызовы

Rel(auth_comp, oauth_comp, "Делегирует внешний логин", "Python Call")

Rel(auth_comp, user_comp, "Проверяет учетные данные и роли", "Python Call")

Rel(auth_comp, session_comp, "Выпускает и проверяет токены", "Python Call")

' Из контейнера наружу

Rel(oauth_comp, idp, "Обменивает код авторизации на профиль", "HTTPS")

Rel(user_comp, database, "Читает/пишет профили", "SQL/TCP")

Rel(session_comp, cache, "Сохраняет сессии и токены", "RESP/TCP")

@enduml
