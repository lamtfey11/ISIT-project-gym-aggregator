@startuml L1

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title Диаграмма системного контекста (Level 1) — ИС "Агрегатор спортивных залов"

' Актёры
Person(client, "Клиент", "Посетитель спортивных залов. Подбирает зал по загруженности и расположению, оформляет и оплачивает абонемент.")
Person(gym_admin, "Администратор зала", "Сотрудник подключённого зала. Ведёт карточку зала, отмечает посещения, анализирует статистику и формирует предложения для клиентов.")
Person(platform_admin, "Администратор платформы", "Сотрудник оператора сервиса. Подключает и модерирует залы, управляет тарифами и разбирает спорные обращения.")

' Проектируемапя система
System(gym_aggregator, "Агрегатор спортивных залов", "Центральная информационная система. Собирает данные о посещаемости залов, рассчитывает индекс загруженности, ведёт каталог залов, абонементы и аналитику.")

' Внешние ситемы
System_Ext(maps_service, "Картографический сервис", "Внешний сервис карт и геокодирования (Яндекс.Карты). Предоставляет подложку карты и координаты залов.")
System_Ext(payment_gateway, "Платёжный шлюз", "Внешняя платёжная система (эквайринг). Проводит безналичные платежи за абонементы.")
System_Ext(access_control, "СКУД и датчики залов", "Внешнее аппаратное обеспечение залов: турникеты, считыватели карт, датчики прохода. Фиксируют факт входа и выхода посетителя.")
System_Ext(push_service, "Сервис push-уведомлений", "Внешняя платформа доставки уведомлений (FCM / APNs). Доставляет сообщения на устройства клиентов.")

' Связи
Rel(client, gym_aggregator, "Просматривает карту залов и индекс загруженности, ведёт список избранных залов, оформляет и оплачивает абонемент", "HTTPS / JSON")
Rel(gym_admin, gym_aggregator, "Ведёт карточку и расписание зала, вручную отмечает посещения, запрашивает отчёты о посещаемости", "HTTPS / JSON")
Rel(platform_admin, gym_aggregator, "Подключает и модерирует залы, настраивает тарифы, просматривает журнал операций", "HTTPS / JSON")

Rel(access_control, gym_aggregator, "Передаёт события прохода посетителей: идентификатор зала, направление, отметка времени", "MQTT / TCP")
Rel(gym_aggregator, maps_service, "Запрашивает картографическую подложку и геокодирование адресов залов", "HTTPS / REST")
Rel(gym_aggregator, payment_gateway, "Инициирует списание средств за абонемент и запрашивает статус транзакции", "HTTPS / REST")
Rel(gym_aggregator, push_service, "Передаёт уведомления о снижении загруженности избранного зала и об окончании абонемента", "HTTPS / REST")

@enduml
