{
  "name": "gw-ratelimit",
  "version": "0.1.0",
  "private": true,
  "description": "Компонент gw_ratelimit контейнера api_gateway (C4 L4, ЛР3): njs-модуль ограничения нагрузки на TypeScript",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "esbuild src/gw_ratelimit.ts --bundle --format=esm --target=es2020 --outfile=dist/gw_ratelimit.js",
    "test": "esbuild tests/limiter.test.ts --bundle --platform=node --format=esm --outfile=build/limiter.test.js && node --test build/limiter.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.6.0"
  }
}
