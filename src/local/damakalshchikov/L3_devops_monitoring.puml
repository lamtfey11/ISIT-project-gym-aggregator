@startuml L3_devops_monitoring
' Зона ответственности: DevOps-инженер
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Диаграмма компонентов (Level 3) — Система наблюдаемости (monitoring)

' === ПОЛЬЗОВАТЕЛИ ===
Person(devops, "DevOps-инженер", "Выпускает релизы, следит за доступностью и метриками")
' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "FCM / APNs, SMS-шлюз, SMTP-сервер")
' === НАБЛЮДАЕМЫЕ КОНТЕЙНЕРЫ ===
Container_Ext(api_gateway, "API-шлюз", "Nginx", "Единая точка входа: терминация TLS 1.3, маршрутизация, проверка токена через сервис авторизации, ограничение частоты запросов, приём webhook и запросов BI.")
Container_Ext(auth_service, "Сервис авторизации", "Python 3.12 / FastAPI", "Регистрация и аутентификация, выпуск JWT-токенов и их проверка по подзапросу шлюза, разграничение прав по ролям, вход через внешнего провайдера идентификации.")
Container_Ext(core_api, "Сервис бизнес-логики", "Python 3.12 / FastAPI, SQLAlchemy", "Ядро предметной области: каталог и геопоиск, карточки и расписание залов, тарифы абонементов, условия размещения и комиссия платформы (расчёт цены и доли комиссии), абонементы и заказы, инициирование возвратов, отзывы, модерация. Списывает занятия абонемента по событиям прохода, сами посещения не хранит.")
Container_Ext(integration_service, "Сервис интеграций и уведомлений", "Python 3.12 / FastAPI, Celery", "Обмен с внешними системами: платежи по суммам от сервиса бизнес-логики, приём webhook, возвраты, расчёт и проведение выплат залам (ведёт реестр выплат), геокодирование адресов, регистрация устройств и рассылка push, SMS и e-mail. Celery только для фоновых задач.")
Container_Ext(iot_service, "Сервис допуска и загруженности", "Python 3.12 / FastAPI, asyncio, aiomqtt", "Приём событий СКУД по MQTT и сканов администратора по HTTP, выдача и проверка QR-пропусков, единый учёт посещений (вход и выход: турникет, сканер администратора, ручная отметка), расчёт индекса загруженности зала по 10-балльной шкале по балансу входов и выходов.")
Container_Ext(analytics_service, "Сервис отчётности", "Python 3.12 / FastAPI, pandas", "Считает показатели по витринам, собирает регламентные отчёты и выгрузки XLSX и CSV, формирует для бухгалтерии реестры начислений из реестра выплат без пересчёта сумм.")
ContainerDb_Ext(database, "Реляционная СУБД", "PostgreSQL 16 + PostGIS 3", "Основное хранилище: пользователи и роли, залы и геоиндексы, тарифы абонементов, условия размещения и комиссии, абонементы, заказы, платежи, реестр выплат, посещения, журнал операций. У каждой таблицы один сервис-владелец, который в неё пишет.")
ContainerQueue_Ext(message_broker, "Брокер сообщений", "RabbitMQ 3", "Доменные события между сервисами (заказы, абонементы, платежи, проходы, готовность отчётов): topic-обменник, у каждого подписчика своя очередь, единый JSON-конверт с идентификатором события.")
' === ГРАНИЦА КОНТЕЙНЕРА ===
Container_Boundary(monitoring, "Система наблюдаемости (monitoring)") {

    Component(scrape_comp, "Сборщик метрик", "Prometheus / scrape manager, service discovery", "По расписанию опрашивает /metrics всех сервисов и хранилищ, добавляет метки сервиса и реплики")

    Component(tsdb_comp, "Хранилище метрик", "Prometheus / TSDB", "Хранит временные ряды 15 дней, выполняет запросы PromQL")

    Component(rules_comp, "Движок правил оповещений", "Prometheus / rule manager", "Раз в минуту вычисляет правила (ошибки 5xx, задержка p95, недоступность цели) и формирует оповещения")

    Component(alert_comp, "Маршрутизатор оповещений", "Alertmanager", "Группирует и подавляет повторы, выбирает получателя по важности и рассылает письма напрямую по SMTP, минуя сервис интеграций, чтобы оповещение о сбое не зависело от наблюдаемых сервисов")

    Component(log_agent, "Агент сбора логов", "Grafana Alloy", "Читает журналы контейнеров, разбирает строки и добавляет метки сервиса")

    Component(logs_comp, "Хранилище логов", "Grafana Loki", "Индексирует журналы по меткам, выполняет запросы LogQL")

    Component(viz_comp, "Панели визуализации", "Grafana", "Строит панели состояния по метрикам и логам, даёт поиск по журналам")
}

' === ПОЛЬЗОВАТЕЛЬ ===
Rel(devops, viz_comp, "Смотрит панели и ищет события в журналах", "HTTPS, TCP 3000")

' === СБОР МЕТРИК ===
Rel(scrape_comp, api_gateway, "Опрашивает метрики шлюза", "HTTP GET /metrics")
Rel(scrape_comp, auth_service, "Опрашивает метрики сервиса", "HTTP GET /metrics")
Rel(scrape_comp, core_api, "Опрашивает метрики сервиса", "HTTP GET /metrics")
Rel(scrape_comp, integration_service, "Опрашивает метрики сервиса", "HTTP GET /metrics")
Rel(scrape_comp, iot_service, "Опрашивает метрики сервиса", "HTTP GET /metrics")
Rel(scrape_comp, analytics_service, "Опрашивает метрики сервиса", "HTTP GET /metrics")
Rel(scrape_comp, database, "Опрашивает метрики СУБД", "HTTP GET /metrics, TCP 9187")
Rel(scrape_comp, message_broker, "Опрашивает метрики очередей", "HTTP GET /metrics, TCP 15692")

' === ВНУТРИ PROMETHEUS ===
Rel(scrape_comp, tsdb_comp, "Записывает полученные отсчёты", "Go Call")
Rel(rules_comp, tsdb_comp, "Читает ряды для вычисления правил", "Go Call")

' === МЕЖДУ КОМПОНЕНТАМИ СТЕКА ===
Rel(rules_comp, alert_comp, "Передаёт сработавшие оповещения", "HTTP/JSON, POST /api/v2/alerts, TCP 9093")
Rel(log_agent, api_gateway, "Читает журналы доступа и ошибок", "Docker Engine API, stdout")
Rel(log_agent, logs_comp, "Отправляет размеченные строки журналов", "HTTP, POST /loki/api/v1/push, TCP 3100")
Rel(viz_comp, tsdb_comp, "Запрашивает метрики для панелей", "HTTP, PromQL, TCP 9090")
Rel(viz_comp, logs_comp, "Запрашивает журналы для панелей", "HTTP, LogQL, TCP 3100")

' === ИСХОДЯЩИЕ НАРУЖУ ===
Rel(alert_comp, notification_gateway, "Отправляет оповещения об инцидентах напрямую, минуя сервис интеграций", "SMTP/TLS, TCP 465")
Rel(notification_gateway, devops, "Доставляет оповещения об инцидентах", "E-mail (SMTP)")

@enduml
