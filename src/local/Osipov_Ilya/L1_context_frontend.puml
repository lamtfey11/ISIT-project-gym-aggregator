@startuml context_local_ilya
' ЛР1. Диаграмма системного контекста (C4, Level 1)
' Локальное представление: клиентская (frontend) точка зрения
' Проект: ИС-агрегатор фитнес-услуг "Зал рядом"

' Если нет доступа в интернет — скачай C4-PlantUML локально
' и замени строку ниже на: !include ./C4/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма системного контекста. Локальное представление: клиентский контур

LAYOUT_WITH_LEGEND()

' ---------- ПЕРСОНЫ (пользовательские роли) ----------
Person(client, "Клиент", "Посетитель фитнес-зала. Ищет зал рядом, покупает абонемент или разовое посещение, проходит в зал по электронному пропуску.")
Person(support, "Оператор поддержки", "Сотрудник платформы. Разбирает обращения клиентов, инициирует возвраты и корректировки абонементов.")
Person(moderator, "Модератор платформы", "Сотрудник платформы. Проверяет карточки залов и пользовательские отзывы перед публикацией.")

' ---------- ПРОЕКТИРУЕМАЯ СИСТЕМА (чёрный ящик) ----------
System(aggregator, "ИС-агрегатор фитнес-услуг «Зал рядом»", "Единая платформа: геопоиск независимых фитнес-залов, расписание, онлайн-продажа абонементов, электронный пропуск в зал, личные кабинеты клиента и партнёра.")

' ---------- ВНЕШНИЕ СИСТЕМЫ (вне зоны контроля команды) ----------
System_Ext(maps, "Картографический сервис", "Яндекс Карты / 2ГИС. Геокодирование адресов, картографические тайлы, расчёт времени в пути до зала.")
System_Ext(idp, "Провайдер идентификации", "VK ID / Sber ID. Внешняя аутентификация пользователя по OAuth 2.0 / OIDC.")
System_Ext(payment, "Платёжный шлюз", "ЮKassa / CloudPayments. Приём платежей за абонементы, токенизация карт, возвраты.")
System_Ext(notify, "Сервис уведомлений", "FCM / APNs и SMS-провайдер. Доставка push- и SMS-сообщений на устройство клиента.")
System_Ext(acs, "СКУД фитнес-зала", "Контроллер турникета на стороне партнёра. Считывает электронный пропуск и фиксирует факт прохода.")

' ---------- СВЯЗИ: ПЕРСОНЫ -> СИСТЕМА ----------
Rel(client, aggregator, "Отправляет геопоисковые запросы и фильтры, оформляет и оплачивает абонемент, публикует отзывы", "HTTPS/JSON")
Rel(moderator, aggregator, "Передаёт вердикты модерации карточек залов и отзывов", "HTTPS/JSON")

' ---------- СВЯЗИ: СИСТЕМА -> ПЕРСОНЫ ----------
Rel(aggregator, support, "Предоставляет карточку обращения: история покупок, визитов и платежей клиента", "HTTPS/JSON")
Rel(aggregator, moderator, "Передаёт очередь непроверенных карточек залов и отзывов", "HTTPS/JSON")

' ---------- СВЯЗИ: СИСТЕМА -> ВНЕШНИЕ СИСТЕМЫ ----------
Rel(aggregator, maps, "Запрашивает геокодирование адреса зала, координаты и время в пути от клиента", "HTTPS/JSON")
Rel(aggregator, idp, "Передаёт запрос авторизации и код подтверждения, получает подтверждённый профиль пользователя", "HTTPS, OAuth 2.0/OIDC")
Rel(aggregator, payment, "Инициирует платёж за абонемент, запрашивает статус транзакции, отправляет заявку на возврат", "HTTPS/JSON")
Rel(aggregator, notify, "Передаёт текст и адресата уведомления о покупке, визите и окончании абонемента", "HTTPS/JSON")
Rel(aggregator, acs, "Передаёт токен электронного пропуска и команду разрешения прохода", "MQTT/TCP")

' ---------- СВЯЗИ: ВНЕШНИЕ СИСТЕМЫ -> СИСТЕМА / КЛИЕНТ ----------
Rel(payment, aggregator, "Возвращает результат оплаты асинхронным уведомлением (callback)", "HTTPS/JSON, webhook")
Rel(notify, client, "Доставляет push- и SMS-уведомления на устройство клиента", "FCM/APNs, SMS")

@enduml
