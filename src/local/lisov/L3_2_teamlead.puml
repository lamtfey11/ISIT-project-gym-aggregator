@startuml L3_iot_service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Диаграмма компонентов контейнера "Сервис допуска и загруженности" (iot_service) ИС "Агрегатор фитнес-клубов"

' === СОСЕДНИЕ КОНТЕЙНЕРЫ (чёрные ящики, описания совпадают со сводной диаграммой контейнеров) ===
Container_Ext(api_gateway, "API-шлюз", "Nginx", "Единая точка входа: терминация TLS 1.3, маршрутизация, проверка токена через сервис авторизации, ограничение частоты запросов, приём webhook и запросов BI.")
Container_Ext(monitoring, "Система наблюдаемости", "Prometheus, Alertmanager, Grafana, Loki", "Собирает метрики и логи контейнеров, строит панели, рассылает оповещения об инцидентах напрямую по SMTP, чтобы оповещение о сбое не зависело от наблюдаемых сервисов.")
ContainerQueue_Ext(mqtt_broker, "MQTT-брокер", "Eclipse Mosquitto 2.0", "Принимает события и запросы СКУД по топикам gym/{gym_id}/access, передаёт команды допуска турникетам.")
ContainerQueue_Ext(message_broker, "Брокер сообщений", "RabbitMQ 3", "Доменные события между сервисами (заказы, абонементы, платежи, проходы, готовность отчётов): topic-обменник, у каждого подписчика своя очередь, единый JSON-конверт с идентификатором события.")
ContainerDb_Ext(database, "Реляционная СУБД", "PostgreSQL 16 + PostGIS 3", "Основное хранилище: пользователи и роли, залы и геоиндексы, тарифы абонементов, условия размещения и комиссии, абонементы, заказы, платежи, реестр выплат, посещения, журнал операций. У каждой таблицы один сервис-владелец, который в неё пишет.")
ContainerDb_Ext(cache, "Кэш и хранилище сессий", "Redis 7", "Кэш геопоиска, актуальный индекс загруженности, сессии и токены, короткоживущие токены пропусков.")
' === ПРОЕКТИРУЕМЫЙ КОНТЕЙНЕР: слои сверху вниз (API -> бизнес-логика -> инфраструктура) ===
Container_Boundary(iot_service, "Сервис допуска и загруженности") {

  Boundary(api_layer, "Слой API (входные интерфейсы)") {
    Component(iot_api_comp, "Контроллер допуска", "FastAPI APIRouter, Pydantic v2", "Принимает по HTTP запросы выдачи и проверки QR-пропуска от клиента, сканы QR-пропусков администратора и ручные отметки входа и выхода; отдаёт метрики сервиса (/metrics).")
  }

  Boundary(service_layer, "Слой бизнес-логики") {
    Component(pass_comp, "Сервис QR-пропусков", "Python (сервисный слой)", "Выпускает короткоживущий токен пропуска (60 с), проверяет токен и признак активации пропуска, принимает активацию пропуска после оплаты абонемента.")
    Component(access_comp, "Сервис допуска", "Python (сервисный слой), asyncio", "Единый учёт посещений: принимает вход и выход от турникета, сканера администратора и ручной отметки, принимает решение о допуске, формирует команду турникету, регистрирует вход или выход.")
    Component(occupancy_comp, "Сервис индекса загруженности", "Python (сервисный слой), asyncio", "Ведёт число посетителей в зале по балансу входов и выходов и пересчитывает индекс загруженности по 10-балльной шкале после каждого события; алгоритм расчёта подключается как сменная стратегия.")
  }

  Boundary(infrastructure_layer, "Слой инфраструктуры (адаптеры к хранилищам и брокерам)") {
    Component(mqtt_gateway_comp, "Клиент MQTT-брокера", "aiomqtt, asyncio", "Держит соединение с брокером: подписывается на топики gym/{gym_id}/access и публикует команды допуска турникетам.")
    Component(iot_repo_comp, "Репозиторий учёта посещений и истории загруженности", "SQLAlchemy 2.0", "Слой доступа к данным: события входа и выхода (турникет, сканер, ручная отметка), параметры залов для расчёта загруженности и история индекса загруженности.")
    Component(iot_cache_comp, "Клиент кэша", "Python (клиент Redis)", "Хранит токены и признаки активации пропусков, текущее число посетителей, публикует актуальный индекс загруженности зала.")
    Component(iot_events_comp, "Шина событий", "Python, aio-pika (AMQP)", "Публикует access.passed; получает subscription.activated и gym.updated из собственной очереди.")
  }
}

' === ВХОДЯЩИЕ СЕТЕВЫЕ ВЫЗОВЫ (стыковочные шлюзы контейнера) ===
Rel(api_gateway, iot_api_comp, "Проксирует выдачу и проверку QR-пропуска, сканы администратора и ручные отметки входа и выхода", "HTTP/JSON, TCP 8004")
Rel(monitoring, iot_api_comp, "Опрашивает метрики сервиса", "HTTP GET /metrics")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: API -> бизнес-логика ===
Rel(iot_api_comp, pass_comp, "Выдаёт и проверяет QR-пропуск", "Python Call")
Rel(iot_api_comp, access_comp, "Передаёт скан администратора и ручную отметку входа или выхода", "Python Call")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: события СКУД и брокера -> бизнес-логика ===
Rel(mqtt_gateway_comp, access_comp, "Передаёт запрос валидации пропуска и событие входа или выхода", "Python Call")
Rel(iot_events_comp, pass_comp, "Передаёт активацию пропуска (subscription.activated)", "Python Call")
Rel(iot_events_comp, occupancy_comp, "Передаёт вместимость зала (gym.updated)", "Python Call")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: внутри слоя бизнес-логики ===
Rel(access_comp, pass_comp, "Проверяет токен и активность пропуска", "Python Call")
Rel(access_comp, occupancy_comp, "Передаёт событие входа или выхода для пересчёта индекса", "Python Call")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: бизнес-логика -> инфраструктура ===
Rel(access_comp, mqtt_gateway_comp, "Передаёт команду допуска турникету", "Python Call")
Rel(access_comp, iot_repo_comp, "Сохраняет событие входа или выхода", "Python Call")
Rel(access_comp, iot_events_comp, "Публикует access.passed", "Python Call")
Rel(pass_comp, iot_cache_comp, "Сохраняет и читает токен и признак активации пропуска", "Python Call")
Rel(occupancy_comp, iot_cache_comp, "Обновляет число посетителей, публикует индекс загруженности", "Python Call")
Rel(occupancy_comp, iot_repo_comp, "Читает журнал входов и выходов, читает и сохраняет параметры зала (вместимость, стратегия), сохраняет историю загруженности", "Python Call")

' === ИСХОДЯЩИЕ СЕТЕВЫЕ ВЫЗОВЫ ===
Rel(mqtt_gateway_comp, mqtt_broker, "Подписывается на топики gym/{gym_id}/access, публикует команды допуска", "MQTT / TCP, порт 1883, внутренняя сеть")
Rel(iot_repo_comp, database, "Ведёт учёт посещений (входы и выходы от турникета, сканера и ручных отметок) и историю загруженности", "SQL/TCP, TCP 5432")
Rel(iot_cache_comp, cache, "Публикует индекс загруженности, хранит токены пропусков", "RESP/TCP, TCP 6379")
Rel(iot_events_comp, message_broker, "Публикует access.passed; получает subscription.activated, gym.updated", "AMQP, TCP 5672")

@enduml
