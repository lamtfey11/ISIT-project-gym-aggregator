@startuml L3_iot_service
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Диаграмма компонентов контейнера "Сервис допуска и загруженности" (iot_service) ИС "Агрегатор фитнес-клубов"

' === СОСЕДНИЕ КОНТЕЙНЕРЫ (чёрные ящики, внутрь не заглядываем) ===
Container_Ext(api_gateway, "API-шлюз", "Nginx", "Единая точка входа: терминация TLS 1.3, маршрутизация, проверка токена через сервис авторизации, ограничение частоты запросов, приём webhook и запросов BI.")
Container_Ext(core_api, "Сервис бизнес-логики", "Python 3.12 / FastAPI, SQLAlchemy", "Ядро предметной области: каталог и геопоиск залов, тарифы, абонементы и заказы, отзывы, модерация, учёт посещений.")
ContainerQueue_Ext(mqtt_broker, "MQTT-брокер", "Eclipse Mosquitto 2.0", "Принимает события и запросы СКУД по топикам gym/{gym_id}/access, передаёт команды допуска турникетам.")
ContainerQueue_Ext(message_broker, "Брокер сообщений", "RabbitMQ 3", "Асинхронный обмен событиями между сервисами: оплата, подписки, проходы, готовность отчётов.")
ContainerDb_Ext(database, "Реляционная СУБД", "PostgreSQL 16 + PostGIS 3", "Основное хранилище: пользователи и роли, залы и геоиндексы, тарифы, абонементы, заказы, платежи, посещения, журнал операций.")
ContainerDb_Ext(cache, "Кэш и хранилище сессий", "Redis 7", "Кэш геопоиска, актуальный индекс загруженности, сессии и токены, короткоживущие токены пропусков.")

' === ПРОЕКТИРУЕМЫЙ КОНТЕЙНЕР: слои сверху вниз (API -> бизнес-логика -> инфраструктура) ===
Container_Boundary(iot_service, "Сервис допуска и загруженности") {

  Boundary(api_layer, "Слой API (входные интерфейсы)") {
    Component(iot_api_comp, "Контроллер допуска и загруженности", "FastAPI APIRouter, Pydantic v2", "Принимает по HTTP запросы выдачи и проверки QR-пропуска, ручные отметки посещений и запросы пересчёта индекса; отдаёт метрики сервиса (/metrics).")
  }

  Boundary(service_layer, "Слой бизнес-логики") {
    Component(pass_comp, "Сервис QR-пропусков", "Python (сервисный слой)", "Выпускает короткоживущий токен пропуска (60 с), проверяет токен и признак активации пропуска, принимает активацию пропуска после оплаты абонемента.")
    Component(access_comp, "Сервис допуска", "Python (сервисный слой), asyncio", "Принимает запрос валидации пропуска и событие прохода, принимает решение о допуске, формирует команду турникету и регистрирует проход, в том числе ручную отметку.")
    Component(occupancy_comp, "Сервис индекса загруженности", "Python (сервисный слой), asyncio", "Пересчитывает индекс загруженности зала по 10-балльной шкале после каждого события прохода; алгоритм расчёта подключается как сменная стратегия.")
  }

  Boundary(infrastructure_layer, "Слой инфраструктуры (адаптеры к хранилищам и брокерам)") {
    Component(mqtt_gateway_comp, "Клиент MQTT-брокера", "aiomqtt, asyncio", "Держит соединение с брокером: подписывается на топики gym/{gym_id}/access и публикует команды допуска турникетам.")
    Component(iot_repo_comp, "Репозиторий событий прохода и истории загруженности", "SQLAlchemy 2.0", "Слой доступа к данным: нормализованные события прохода и история индекса загруженности.")
    Component(iot_cache_comp, "Клиент кэша", "Python (клиент Redis)", "Хранит токены и признаки активации пропусков, публикует актуальный индекс загруженности зала.")
    Component(iot_events_comp, "Шина событий", "Python (клиент AMQP)", "Публикует события прохода и получает события активации пропусков.")
  }
}

' === ВХОДЯЩИЕ СЕТЕВЫЕ ВЫЗОВЫ (стыковочные шлюзы контейнера) ===
Rel(api_gateway, iot_api_comp, "Проксирует запросы выдачи и проверки QR-пропуска", "HTTP/JSON, TCP 8004")
Rel(core_api, iot_api_comp, "Передаёт ручные отметки посещений, запрашивает пересчёт индекса", "HTTP/JSON, TCP 8004")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: API -> бизнес-логика ===
Rel(iot_api_comp, pass_comp, "Выдаёт и проверяет QR-пропуск", "Python Call")
Rel(iot_api_comp, access_comp, "Передаёт ручную отметку посещения", "Python Call")
Rel(iot_api_comp, occupancy_comp, "Запускает пересчёт индекса загруженности", "Python Call")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: события СКУД и брокера -> бизнес-логика ===
Rel(mqtt_gateway_comp, access_comp, "Передаёт запрос валидации пропуска и событие прохода", "Python Call")
Rel(iot_events_comp, pass_comp, "Передаёт событие активации пропуска", "Python Call")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: внутри слоя бизнес-логики ===
Rel(access_comp, pass_comp, "Проверяет токен и активность пропуска", "Python Call")
Rel(access_comp, occupancy_comp, "Передаёт событие прохода для пересчёта индекса", "Python Call")

' === ВНУТРИПРОЦЕССНЫЕ ВЫЗОВЫ: бизнес-логика -> инфраструктура ===
Rel(access_comp, mqtt_gateway_comp, "Передаёт команду допуска турникету", "Python Call")
Rel(access_comp, iot_repo_comp, "Сохраняет событие прохода", "Python Call")
Rel(access_comp, iot_events_comp, "Публикует событие прохода", "Python Call")
Rel(pass_comp, iot_cache_comp, "Сохраняет и читает токен и признак активации пропуска", "Python Call")
Rel(occupancy_comp, iot_cache_comp, "Публикует актуальный индекс загруженности", "Python Call")
Rel(occupancy_comp, iot_repo_comp, "Сохраняет и читает историю загруженности", "Python Call")

' === ИСХОДЯЩИЕ СЕТЕВЫЕ ВЫЗОВЫ ===
Rel(mqtt_gateway_comp, mqtt_broker, "Подписывается на топики gym/{gym_id}/access, публикует команды допуска", "MQTT / TCP, порт 1883, внутренняя сеть")
Rel(iot_repo_comp, database, "Сохраняет нормализованные события прохода и историю загруженности", "SQL/TCP, TCP 5432")
Rel(iot_cache_comp, cache, "Публикует индекс загруженности, хранит токены пропусков", "RESP/TCP, TCP 6379")
Rel(iot_events_comp, message_broker, "Публикует события прохода, подписывается на активацию пропусков", "AMQP, TCP 5672")

@enduml