@startuml L4_iot_occupancy_service
' C4 Level 4 (Code). Нотация: UML Class Diagram (функциональный компонент).
' Компонент iot_occupancy_service «Сервис индекса загруженности» контейнера iot_service.
' Python-пакет компонента: src/iot_occupancy_service. Автор: Лисов М. И.
' Имена классов, полей и методов совпадают с кодом.

title Диаграмма кода (C4, уровень 4): компонент «Сервис индекса загруженности» (iot_occupancy_service; на L3 — occupancy_comp) контейнера «Сервис допуска и загруженности» (iot_service)

hide empty members
left to right direction

package "Контракты на стыках (fitagg_contracts)" <<Frame>> {
  enum Direction {
    IN
    OUT
  }
  enum AccessSource {
    TURNSTILE
    ADMIN_SCANNER
    MANUAL
  }
  class GymUpdated <<contract gym.updated>> {
    +gym_id: UUID
    +capacity: int
    +closing_time: time | None
  }
  class AccessPassed <<contract access.passed>> {
    +visit_event_id: UUID
    +gym_id: UUID
    +user_id: UUID
    +subscription_id: UUID | None
    +direction: Direction
    +source: AccessSource
    +occurred_at: datetime
  }
}

package "Предметная модель (domain, scale)" {
  class OccupancyEvent <<dataclass>> {
    +gym_id: UUID
    +visitor_id: UUID
    +direction: Direction
    +occurred_at: datetime
    +{static} from_access_passed(event: AccessPassed): OccupancyEvent
  }
  class GymOccupancySettings <<dataclass>> {
    +gym_id: UUID
    +capacity: int
    +strategy_name: str
    +connected_since: datetime
    +closing_time: time | None
  }
  enum OccupancyStatus {
    AVAILABLE
    INSUFFICIENT_DATA
  }
  class OccupancySnapshot <<dataclass>> {
    +gym_id: UUID
    +status: OccupancyStatus
    +visitors: int | None
    +index: int | None
    +strategy_name: str | None
    +calculated_at: datetime
  }
  class OccupancyScale {
    +{static} MIN_INDEX: int = 1
    +{static} MAX_INDEX: int = 10
    +to_index(visitors: int, capacity: int): int
  }
}

package "Стратегии — шаблон Strategy (strategies)" {
  interface OccupancyStrategy {
    +name: str
    +estimate(events: Sequence[OccupancyEvent], now: datetime): int
  }
  class ExactBalanceStrategy {
    +name: str = "exact_balance"
    +estimate(events: Sequence[OccupancyEvent], now: datetime): int
  }
  class VisitTimeoutStrategy {
    -_max_visit: timedelta
    +__init__(max_visit: timedelta = 3 ч)
    +name: str = "visit_timeout"
    +estimate(events: Sequence[OccupancyEvent], now: datetime): int
  }
  class SmoothedStrategy {
    -_base: OccupancyStrategy
    -_window: timedelta
    -_step: timedelta
    +__init__(base: OccupancyStrategy, window: timedelta = 10 мин, step: timedelta = 1 мин)
    +name: str = "smoothed_<base>"
    +estimate(events: Sequence[OccupancyEvent], now: datetime): int
  }
  class OccupancyStrategyRegistry {
    -_strategies: dict[str, OccupancyStrategy]
    +register(strategy: OccupancyStrategy): None
    +get(name: str): OccupancyStrategy
    +names(): list[str]
  }
  class strategies <<module strategies.py>> {
    +build_default_registry(): OccupancyStrategyRegistry
  }
}

package "Контекст (service)" {
  class OccupancyService {
    -_default_strategy_name: str
    -_window: timedelta
    -_warmup: timedelta
    +on_access(event: OccupancyEvent): OccupancySnapshot
    +apply_gym_update(update: GymUpdated): None
    +use_strategy(gym_id: UUID, strategy_name: str): None
    +set_default_strategy(strategy_name: str): None
    +recalculate(gym_id: UUID): OccupancySnapshot
    -_since(settings: GymOccupancySettings, now: datetime): datetime
  }
}

package "Порты: интерфейсы соседних компонентов iot_service (ports)" {
  interface AccessEventSource <<iot_repository>> {
    +events_since(gym_id: UUID, since: datetime): Sequence[OccupancyEvent]
  }
  interface OccupancyHistoryRepository <<iot_repository>> {
    +save(snapshot: OccupancySnapshot): None
  }
  interface OccupancyPublisher <<iot_cache_client>> {
    +publish(snapshot: OccupancySnapshot): None
  }
  interface GymSettingsStore <<iot_repository>> {
    +get(gym_id: UUID): GymOccupancySettings | None
    +save(settings: GymOccupancySettings): None
  }
  interface Clock {
    +now(): datetime
  }
}

package "Реализации портов для тестов и демо (adapters_memory)" {
  class InMemoryAccessEventSource {
    +add(event: OccupancyEvent): None
  }
  class InMemoryOccupancyHistory
  class InMemoryOccupancyPublisher
  class InMemoryGymSettingsStore
  class FixedClock {
    +set(now: datetime): None
  }
}

' --- Шаблон «Стратегия» ---
ExactBalanceStrategy ..|> OccupancyStrategy
VisitTimeoutStrategy ..|> OccupancyStrategy
SmoothedStrategy ..|> OccupancyStrategy
SmoothedStrategy o-- "1" OccupancyStrategy : _base\n(сглаживает любую стратегию)
OccupancyStrategyRegistry o-- "*" OccupancyStrategy : _strategies
strategies ..> OccupancyStrategyRegistry : создаёт и наполняет
OccupancyStrategy ..> OccupancyEvent : читает

' --- Контекст: реестр и шкала передаются в конструктор (агрегация) ---
OccupancyService o-- "1" OccupancyStrategyRegistry : _registry
OccupancyService o-- "1" OccupancyScale : _scale
OccupancyService ..> OccupancyStrategy : estimate()\nстратегия зала по strategy_name

' --- Порты (инверсия зависимостей): поля контекста ---
OccupancyService --> "1" AccessEventSource : _events
OccupancyService --> "1" OccupancyHistoryRepository : _history
OccupancyService --> "1" OccupancyPublisher : _publisher
OccupancyService --> "1" GymSettingsStore : _settings
OccupancyService --> "1" Clock : _clock

' --- Модель данных ---
OccupancyService ..> OccupancySnapshot : создаёт
OccupancyService ..> GymOccupancySettings : создаёт / меняет
OccupancyService ..> GymUpdated : получает (gym.updated)
OccupancyEvent ..> AccessPassed : строится из
OccupancyEvent --> Direction
AccessPassed --> Direction
AccessPassed --> AccessSource
OccupancySnapshot --> OccupancyStatus
AccessEventSource ..> OccupancyEvent
OccupancyHistoryRepository ..> OccupancySnapshot
OccupancyPublisher ..> OccupancySnapshot
GymSettingsStore ..> GymOccupancySettings

' --- Реализации портов (структурно, через typing.Protocol) ---
InMemoryAccessEventSource ..|> AccessEventSource
InMemoryOccupancyHistory ..|> OccupancyHistoryRepository
InMemoryOccupancyPublisher ..|> OccupancyPublisher
InMemoryGymSettingsStore ..|> GymSettingsStore
FixedClock ..|> Clock

note bottom of OccupancyService
  Контекст не знает конкретного алгоритма: у каждого зала своя
  стратегия (GymOccupancySettings.strategy_name), контекст берёт её
  из реестра и подменяет во время работы (use_strategy).
  Индекс скрыт (INSUFFICIENT_DATA), пока зал не передал
  вместимость и не прошёл warmup (UC13, extend).
end note

legend right
  <b>Условные обозначения</b>
  ..|>  реализация интерфейса (у портов — структурная, typing.Protocol)
  o--   агрегация: объект передаётся в конструктор и живёт отдельно
  -->   ассоциация: поле класса (подпись — имя поля)
  ..>   зависимость: создаёт, читает или вызывает
  interface — в Python: ABC с абстрактными методами (OccupancyStrategy)
             или typing.Protocol (порты)
  «dataclass» — неизменяемый класс данных (@dataclass(frozen=True))
  «contract …» — общий тип на стыке контейнеров, событие RabbitMQ
  «module» — функции модуля вне классов
  «iot_repository», «iot_cache_client» — глобальный ID компонента (глоссарий ЛР2),
             который реализует порт в рабочей системе
  + публичный, - приватный член; {static} — член класса
endlegend

@enduml
