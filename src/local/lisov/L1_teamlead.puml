@startuml "Fitness Aggregator - Context (Teamlead local view)"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title Диаграмма системного контекста - ИС "Агрегатор фитнес-клубов" (локальное представление: Тимлид)

'ГЛОССАРИЙ ID'
Person(client, "Клиент", "Ищет фитнес-залы рядом и покупает абонементы онлайн")
Person(partner_admin, "Администратор зала (партнёр)", "Публикует зал в каталоге, управляет тарифами, расписанием и наполнением карточки")
Person(platform_operator, "Оператор платформы", "Проверяет и одобряет карточки залов перед публикацией, настраивает условия комиссии")

System_Ext(payment_gateway, "Банковский эквайринг / платёжный шлюз", "Внешняя платёжная система с поддержкой маркетплейс-схемы (сплит-платежи)")
System_Ext(maps_service, "Картографический сервис", "Внешний провайдер карт и геокодирования (Яндекс.Карты / 2ГИС API)")
System_Ext(sms_provider, "Провайдер SMS / Push-уведомлений", "Внешний сервис доставки уведомлений")

System(fitness_platform, "Fitness Aggregator", "Информационная система-агрегатор малых фитнес-залов: поиск, каталог, онлайн-оплата абонементов")

Rel(client, fitness_platform, "Ищет залы рядом, покупает абонемент", "HTTPS")
Rel(partner_admin, fitness_platform, "Публикует и обновляет карточку зала, тарифы, расписание", "HTTPS")
Rel(platform_operator, fitness_platform, "Модерирует карточки залов, управляет комиссией платформы", "HTTPS")

Rel(fitness_platform, payment_gateway, "Проводит оплату абонемента, запрашивает статус транзакции", "HTTPS/REST")
Rel(fitness_platform, maps_service, "Запрашивает геокодирование адресов и картографическую подложку", "HTTPS/REST")
Rel(fitness_platform, sms_provider, "Отправляет уведомления о брони и оплате", "HTTPS/REST")
Rel(sms_provider, client, "Доставляет SMS/push-уведомление", "SMS / Push")

@enduml