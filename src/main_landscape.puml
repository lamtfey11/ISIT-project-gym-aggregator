@startuml main_landscape
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title Сводная диаграмма системного ландшафта (Level 0) ИС "Агрегатор фитнес-клубов"

' === ИТ-КОНТУР КОМПАНИИ-ОПЕРАТОРА ПЛАТФОРМЫ (защищённый контур, ПДн клиентов хранятся только здесь) ===
Enterprise_Boundary(platform_company, "ИТ-контур компании-оператора платформы") {
  Person(platform_operator, "Оператор платформы", "Модерирует залы и отзывы, настраивает условия размещения и комиссию, обрабатывает обращения и возвраты")
  Person(analyst, "Аналитик платформы", "Проектирует показатели и витрины, готовит регламентную и ad-hoc отчётность")
  Person(devops, "DevOps-инженер", "Выпускает релизы, следит за доступностью, реагирует на инциденты")
  Person(accountant, "Бухгалтер платформы", "Принимает реестры начислений, проводит акты и выплаты залам в учёте")

  System(gym_aggregator, "ИС-агрегатор фитнес-клубов", "Геопоиск малых залов, продажа абонементов, допуск по QR-пропуску, учёт посещений и индекс загруженности, отчётность. Персональные данные клиентов хранятся только в этом контуре (ФЗ-152), данные карт не хранятся")
  System_Ext(accounting_system, "Система бухгалтерского учёта", "1С:Бухгалтерия: акты и реестры начислений по залам")
  System_Ext(bi_platform, "BI-платформа", "Yandex DataLens, корпоративное пространство: дашборды поверх витрин")
  System_Ext(ci_cd, "Платформа разработки и CI/CD", "GitHub: репозиторий, Actions, реестр образов GHCR")
}

' === ИТ-КОНТУР ПАРТНЁРСКОГО ЗАЛА (вне контроля команды) ===
Enterprise_Boundary(partner_gym, "ИТ-контур партнёрского зала") {
  Person(gym_admin, "Администратор зала", "Ведёт карточку и тарифы абонементов, сканирует QR-пропуска на входе и выходе или отмечает их вручную, смотрит отчёты")
  System_Ext(access_control, "СКУД и датчики залов", "Турникеты и считыватели на стороне партнёра: проверяют пропуск, фиксируют вход и выход")
  System_Ext(gym_crm, "Учётная система зала", "Собственная CRM или 1С:Фитнес клуб у части залов: клиентская база и касса зала")
}

Person_Ext(client, "Клиент", "Посетитель фитнес-зала: ищет зал рядом, покупает абонемент, проходит в зал по QR-пропуску")

' === ФИНАНСОВАЯ ИНФРАСТРУКТУРА ===
Enterprise_Boundary(finance, "Финансовая инфраструктура") {
  System_Ext(payment_gateway, "Платёжный шлюз", "Банк-эквайер с маркетплейс-схемой: платежи, сплит, возвраты, выплаты залам")
  System_Ext(fiscal_service, "Онлайн-касса и ОФД", "Касса эквайера: фискализирует оплату по 54-ФЗ и передаёт чек в ФНС")
}

' === ВНЕШНИЕ ПРОВАЙДЕРЫ И ГОСУДАРСТВЕННЫЕ СЕРВИСЫ ===
System_Ext(idp, "Провайдер идентификации", "VK ID / Sber ID: внешняя аутентификация по OAuth 2.0 / OIDC")
System_Ext(maps_service, "Картографический сервис", "Яндекс Карты / 2ГИС: карта, геокодирование, маршруты")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "FCM / APNs, SMS-шлюз, SMTP-сервер")
System_Ext(fns_egrul, "Сервис проверки контрагентов ФНС", "ЕГРЮЛ / ЕГРИП: реквизиты юрлица или ИП зала")

' === ЛЮДИ И ПРОЕКТИРУЕМАЯ СИСТЕМА (связи совпадают со сводной L1) ===
Rel(client, gym_aggregator, "Ищет залы рядом, оформляет и оплачивает абонемент, проходит в зал по QR-пропуску", "HTTPS/JSON")
Rel(gym_admin, gym_aggregator, "Ведёт карточку и тарифы, сканирует QR-пропуска или отмечает вход и выход вручную, смотрит отчёты", "HTTPS/JSON")
Rel(platform_operator, gym_aggregator, "Модерирует залы и отзывы, настраивает условия размещения и комиссию", "HTTPS/JSON")
Rel(analyst, gym_aggregator, "Настраивает показатели и витрины, формирует регламентные отчёты", "HTTPS/JSON")
Rel(devops, gym_aggregator, "Смотрит метрики, логи и состояние сервисов", "HTTPS")

' === СМЕЖНЫЕ КОРПОРАТИВНЫЕ СИСТЕМЫ ===
Rel(gym_aggregator, accounting_system, "Выгружает реестры начислений и акты по залам за период", "HTTPS/REST, XML")
Rel(bi_platform, gym_aggregator, "Читает витрины данных для дашбордов (только чтение)", "SQL over HTTPS")
Rel(analyst, bi_platform, "Строит ad-hoc дашборды поверх витрин", "HTTPS")
Rel(accountant, accounting_system, "Проводит акты и выплаты залам по реестрам", "HTTPS (тонкий клиент 1С)")
Rel(devops, ci_cd, "Ведёт репозиторий, запускает выпуск релиза", "HTTPS, Git over SSH")
Rel(gym_aggregator, ci_cd, "Скачивает образы контейнеров нового релиза (только при выпуске)", "Docker Registry API over HTTPS")

' === КОНТУР ЗАЛА ===
Rel(access_control, gym_aggregator, "Передаёт запросы валидации пропуска и события прохода, получает команды допуска", "MQTTS / TLS")
Rel(gym_admin, gym_crm, "Ведёт собственную клиентскую базу и кассу зала (интеграция вне MVP)", "HTTPS")

' === ФИНАНСЫ ===
Rel(gym_aggregator, payment_gateway, "Создаёт платёж с разбивкой суммы, оформляет возвраты и выплаты залам", "HTTPS/REST")
Rel(payment_gateway, gym_aggregator, "Сообщает статус платежа (webhook)", "HTTPS/JSON")
Rel(payment_gateway, fiscal_service, "Передаёт данные оплаты для чека", "HTTPS/REST")
Rel(fiscal_service, client, "Направляет электронный чек об оплате", "E-mail / SMS")

' === ВНЕШНИЕ ПРОВАЙДЕРЫ ===
Rel(gym_aggregator, idp, "Передаёт запрос авторизации, получает подтверждённый профиль", "HTTPS, OAuth 2.0 / OIDC")
Rel(gym_aggregator, maps_service, "Запрашивает карту, геокодирование адресов и время в пути", "HTTPS/REST")
Rel(gym_aggregator, notification_gateway, "Передаёт push, SMS и e-mail, оповещения об инцидентах", "HTTPS/REST, SMTP/TLS")
Rel(notification_gateway, client, "Доставляет push- и SMS-уведомления", "FCM/APNs, SMS")
Rel(notification_gateway, gym_admin, "Доставляет отчёт по загрузке и продажам зала", "E-mail (SMTP)")
Rel(notification_gateway, analyst, "Доставляет оповещения о сбое расчёта витрин", "E-mail (SMTP)")
Rel(notification_gateway, devops, "Доставляет оповещения об инцидентах", "E-mail (SMTP)")
Rel(platform_operator, fns_egrul, "Проверяет реквизиты юрлица или ИП зала перед одобрением карточки", "HTTPS")

@enduml
